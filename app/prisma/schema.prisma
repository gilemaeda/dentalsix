generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoConta {
  CONSULTORIO
  CLINICA_I
  CLINICA_II
  ADMIN
}

model Conta {
  id_conta   Int       @id @default(autoincrement())
  tx_nome    String    @db.VarChar(200)
  cd_tipo    TipoConta @default(CONSULTORIO)
  fl_ativo   Boolean   @default(true)
  dt_criacao DateTime  @default(now())

  usuarios            Usuario[]
  prestadores         Prestador[]
  pacientes           Paciente[]
  agendas             Agenda[]
  agendaItens         AgendaItem[]
  especialidades      Especialidade[]
  convenios           Convenio[]
  modulos             AppModulo[]
  fornecedores        Fornecedor[]
  contasBancarias     ContaBancaria[]
  tratamentos         Tratamento[]
  unidades            UnidadeAtendimento[]
  categoriasConta     CategoriaConta[]
  tabelasProcedimento TabelaProcedimento[]
  tabelasMaterial     TabelaMaterial[]
  medicamentos        Medicamento[]
  recebimentos        Recebimento[]
  despesas            Despesa[]
  retornos            Retorno[]
  credenciamentos     Credenciamento[]
  estoqueItens        EstoqueItem[]
  escolas             Escola[]
  ptItens             PtItem[]
  receberCrs          ReceberCR[]
  fluxosCaixa         FluxoCaixa[]
  anamneses           Anamnese[]
  editoresTexto       EditorTexto[]
  documentos          Documento[]
  historicos          Historico[]
  regrasComissao      RegraComissao[]
  cartoesTransacao    CartaoTransacao[]
  perfis              Perfil[]
  repasses            Repasse[]
  gruposConta         GrupoConta[]
  camposLivres        CampoLivre[]
  agendaBloqueios     AgendaBloqueio[]
  agendaReservas      AgendaReserva[]
  beneficios          Beneficio[]
  pagarCrs            PagarCR[]
  servicosProtese     ServicoProtese[]
  pacienteEnderecos   PacienteEndereco[]
  pacienteFones       PacienteFone[]
  pacienteEmails      PacienteEmail[]
  pacienteBeneficios  PacienteBeneficio[]
  prestadorEnderecos  PrestadorEndereco[]
  prestadorFones      PrestadorFone[]
  prestadorEmails     PrestadorEmail[]
  recibos             Recibo[]
  taxasCobranca       TaxaCobranca[]
  simbolosOdonto      SimboloOdonto[]
  ptItensEndo         PtItemEndo[]
  reservas            Reserva[]
  avisos              Aviso[]
  malasDiretas        MalaDireta[]
  empresaEnderecos    EmpresaEndereco[]
  empresaFones        EmpresaFone[]
  empresaEmails       EmpresaEmail[]
  checkoutContas      CheckoutConta[]
  checkoutCarteiras   CheckoutCarteira[]
  estoques            Estoque[]
  rpsList             Rps[]
  assinaturasDigitais AssinaturaDigital[]
  sigPtItens          SigPtItem[]
  timelineItens       TimelineItem[]
  pessoaDocumentos    PessoaDocumento[]
  ptParcelasTmp       PtParcelaTmp[]
  tituloItens         TituloItem[]
  prestadorContaPrefs PrestadorContaPreferencia[]
  restricoesFinanc    RestricaoFinanceira[]
  receberDbParcelas   ReceberDBParcela[]
  ptArcadaAnomalias   PtArcadaAnomalia[]
  confirmacoes        Confirmacao[]
  envioLotes          EnvioLote[]
  linkAnamneses       LinkAnamnese[]
  editorRascunhos     EditorRascunho[]
  agendaItemCampos    AgendaItemCampo[]
  dataExports         DataExport[]
  dataExportItens     DataExportItem[]
  relatorioUsuarios   RelatorioUsuario[]
  reservaIntegracoes  ReservaIntegracao[]
  chkCartTipoParc     CheckoutCarteiraTipoParcelamento[]
  chkCobrancaLogs     CheckoutCobrancaLog[]
  chkCobrancaParcelas CheckoutCobrancaParcela[]
  chkTipoParcelamento CheckoutTipoParcelamento[]
  chkContaDocumentos  CheckoutContaDocumento[]
  chkExtratos         CheckoutExtrato[]
  restricoesFinPac    RestricaoFinanceiraPaciente[]
  pacienteFotos       PacienteFoto[]
  prestadorFotos      PrestadorFoto[]
  rpsEmitentes        RpsEmitente[]

  @@map("conta")
}

// ─── USUARIO ─────────────────────────────────────────────────────

model Usuario {
  id_usuario Int      @id @default(autoincrement())
  tx_login   String   @db.VarChar(200)
  tx_email   String   @unique @db.VarChar(200)
  tx_senha   String   @db.VarChar(200)
  tx_nome    String   @db.VarChar(200)
  fl_ativo   Boolean  @default(true)
  dt_criacao DateTime @default(now())

  id_conta Int
  conta    Conta @relation(fields: [id_conta], references: [id_conta])

  id_prestador Int?
  id_perfil    Int?

  // --- campos adicionais RE-COMPLETA ---
  cd_usuario                     String?  @db.VarChar(50)
  tx_descricao                   String?  @db.VarChar(200)
  id_agenda                      Int?
  id_tipo_conta                  Int?
  id_tipo_prestador              Int?
  id_prestador_conta             Int?
  id_def_cpagar_conta            Int?
  id_unidade_atendimento         Int?
  id_def_texto_sms_agendamento   Int?
  id_def_texto_receita           Int?
  id_def_texto_atestado          Int?
  id_def_modelo_etiqueta         Int?
  id_def_modelo_orcamento        Int?
  vl_qtd_unidade                 Int?
  vl_saldo_sms                   Int?
  vl_pref_doc_organizar          String?  @db.VarChar(50)
  vl_pref_doc_tamanho            String?  @db.VarChar(50)
  tx_ddi_local                   String?  @db.VarChar(10)
  tx_ddd_local                   String?  @db.VarChar(10)
  tx_crm_url                     String?  @db.VarChar(500)
  tx_lista_id_agenda_notify      String?  @db.Text

  // flags de controle
  fl_reiniciar                   Boolean  @default(false)
  fl_bloquear                    Boolean  @default(false)
  fl_reiniciar_senha             Boolean  @default(false)
  fl_esqueci_senha               Boolean  @default(false)
  fl_admin_conta                 Boolean  @default(false)
  fl_desmarcar_dentes            Boolean  @default(false)
  fl_remover_9_ddd31             Boolean  @default(false)
  fl_notificacao                 Boolean  @default(false)
  fl_controle_horario            Boolean  @default(false)
  fl_controle_unidade            Boolean  @default(false)
  fl_controle_prestador          Boolean  @default(false)
  fl_conectividade_tiss          Boolean  @default(false)
  fl_sig_plataforma              Boolean  @default(false)
  fl_asaas_habilitado            Boolean  @default(false)
  fl_asaas                       Boolean  @default(false)
  fl_agenda_unidade              Boolean  @default(false)
  fl_crm                         Boolean  @default(false)
  fl_creceber_paciente_ativo     Boolean  @default(false)
  fl_nova_interface_ficha_clinica Boolean @default(false)
  fl_nfse_asaas                  Boolean  @default(false)

  permissoes LoginPermissao[]
  sessoes    Sessao[]

  @@map("usuario")
}

// ─── PRESTADOR ───────────────────────────────────────────────────

model Prestador {
  id_prestador           Int      @id @default(autoincrement())
  tx_nome                String   @db.VarChar(200)
  tx_apelido             String?  @db.VarChar(100)
  tx_cpf                 String?  @db.VarChar(14)
  tx_cro                 String?  @db.VarChar(50)
  id_cro_uf              String?  @db.VarChar(2)
  tx_email               String?  @db.VarChar(200)
  tx_celular             String?  @db.VarChar(20)
  cd_tipo                String?  @db.VarChar(50)
  fl_habilitado          Boolean  @default(true)
  fl_ativo               Boolean  @default(true)
  dt_criacao             DateTime @default(now())
  cd_tipo_pessoa         String?  @db.VarChar(20)
  tx_codigo              String?  @db.VarChar(50)
  id_tipo_prestador      String?  @db.VarChar(50)
  id_tipo_pessoa         String?  @db.VarChar(50)
  tx_razao_social        String?  @db.VarChar(200)
  tx_cnpj                String?  @db.VarChar(18)
  tx_observacoes         String?  @db.Text
  tx_email_remetente     String?  @db.VarChar(200)
  id_resp_sexo           String?  @db.VarChar(20)
  id_resp_estado_civil   String?  @db.VarChar(20)
  id_resp_prefixo        String?  @db.VarChar(20)
  tx_resp_nome           String?  @db.VarChar(200)
  tx_resp_cpf            String?  @db.VarChar(14)
  tx_resp_cro            String?  @db.VarChar(50)
  id_resp_cro_uf         String?  @db.VarChar(2)
  tx_resp_doc            String?  @db.VarChar(30)
  id_resp_tipo_doc       String?  @db.VarChar(20)
  id_resp_doc_uf         String?  @db.VarChar(2)
  id_resp_doc_orgao      String?  @db.VarChar(50)
  dt_resp_data_nasc      DateTime?
  tx_resp_inss           String?  @db.VarChar(30)
  id_tipo_endereco       String?  @db.VarChar(20)
  tx_cep                 String?  @db.VarChar(10)
  id_tipo_logradouro     String?  @db.VarChar(10)
  tx_endereco            String?  @db.VarChar(200)
  tx_numero              String?  @db.VarChar(10)
  tx_complemento         String?  @db.VarChar(50)
  tx_referencia          String?  @db.VarChar(100)
  id_uf                  String?  @db.VarChar(2)
  id_cidade              String?  @db.VarChar(100)
  id_bairro              String?  @db.VarChar(100)
  id_tipo_fone1          String?  @db.VarChar(20)
  tx_fone_ddd1           String?  @db.VarChar(4)
  tx_fone_nro1           String?  @db.VarChar(20)
  tx_fone_ram1           String?  @db.VarChar(10)
  id_tipo_fone2          String?  @db.VarChar(20)
  tx_fone_ddd2           String?  @db.VarChar(4)
  tx_fone_nro2           String?  @db.VarChar(20)
  tx_fone_ram2           String?  @db.VarChar(10)
  id_tipo_email1         String?  @db.VarChar(20)
  tx_email1              String?  @db.VarChar(200)
  id_tipo_email2         String?  @db.VarChar(20)
  tx_email2              String?  @db.VarChar(200)

  id_conta Int
  conta    Conta @relation(fields: [id_conta], references: [id_conta])

  id_especialidade       Int?
  especialidade          Especialidade? @relation(fields: [id_especialidade], references: [id_especialidade])

  id_prestador_principal Int?

  agendas         Agenda[]
  agendaItens     AgendaItem[]
  tratamentos     Tratamento[]
  credenciamentos Credenciamento[]
  retornos        Retorno[]
  contasBancarias ContaBancaria[]
  ptItens         PtItem[]
  receberCrs      ReceberCR[]
  fluxosCaixa     FluxoCaixa[]
  historicos      Historico[]
  regrasComissao  RegraComissao[]
  enderecos       PrestadorEndereco[]
  fones           PrestadorFone[]
  emailsSub       PrestadorEmail[]

  @@map("prestador")
}

// ─── PACIENTE ────────────────────────────────────────────────────

model Paciente {
  id_paciente      Int       @id @default(autoincrement())
  tx_nome          String    @db.VarChar(200)
  dt_nascimento    DateTime?
  id_sexo          String?   @db.VarChar(20)
  tx_cpf           String?   @db.VarChar(14)
  id_doc_tipo      String?   @db.VarChar(20)
  tx_doc_nro       String?   @db.VarChar(30)
  tx_apelido       String?   @db.VarChar(100)
  tx_nome_social   String?   @db.VarChar(200)
  tx_nome_conjuge  String?   @db.VarChar(200)
  tx_nome_mae      String?   @db.VarChar(200)
  tx_nome_pai      String?   @db.VarChar(200)
  id_estado_civil  String?   @db.VarChar(20)
  id_tipo_indicacao String?  @db.VarChar(50)
  tx_indicacao     String?   @db.VarChar(200)
  tx_prontuario    String?   @db.VarChar(30)
  tx_observ        String?   @db.Text
  id_ocupacao      String?   @db.VarChar(50)
  id_raca          String?   @db.VarChar(20)
  tx_codigo        String?   @db.VarChar(50)
  id_situacao      String?   @db.VarChar(20)
  id_status        String?   @db.VarChar(20)
  tx_portal        String?   @db.VarChar(255)
  tx_foto          String?   @db.Text
  id_tipo_endereco String?   @db.VarChar(20)
  tx_cep           String?   @db.VarChar(10)
  id_tipo_logradouro String? @db.VarChar(10)
  tx_endereco      String?   @db.VarChar(200)
  tx_numero        String?   @db.VarChar(10)
  tx_complemento   String?   @db.VarChar(50)
  tx_referencia    String?   @db.VarChar(100)
  id_uf            String?   @db.VarChar(2)
  id_cidade        String?   @db.VarChar(100)
  id_bairro        String?   @db.VarChar(100)
  id_tipo_fone1    String?   @db.VarChar(20)
  tx_fone_ddd1     String?   @db.VarChar(4)
  tx_fone_nro1     String?   @db.VarChar(20)
  tx_fone_ram1     String?   @db.VarChar(10)
  id_tipo_fone2    String?   @db.VarChar(20)
  tx_fone_ddd2     String?   @db.VarChar(4)
  tx_fone_nro2     String?   @db.VarChar(20)
  tx_fone_ram2     String?   @db.VarChar(10)
  id_tipo_fone3    String?   @db.VarChar(20)
  tx_fone_ddd3     String?   @db.VarChar(4)
  tx_fone_nro3     String?   @db.VarChar(20)
  tx_fone_ram3     String?   @db.VarChar(10)
  id_tipo_email1   String?   @db.VarChar(20)
  tx_email1        String?   @db.VarChar(200)
  id_tipo_email2   String?   @db.VarChar(20)
  tx_email2        String?   @db.VarChar(200)
  fl_tem_plano     Boolean   @default(false)
  id_operadora     Int?
  id_produto       String?   @db.VarChar(50)
  id_tab_prc       Int?
  tx_matricula     String?   @db.VarChar(30)
  dt_validade      DateTime?
  tx_campos_livres String?   @db.Text
  fl_publico       Boolean   @default(false)
  fl_ativo         Boolean   @default(true)
  dt_criacao       DateTime  @default(now())

  id_conta         Int
  conta            Conta @relation(fields: [id_conta], references: [id_conta])

  id_prestador_res Int?

  agendaItens  AgendaItem[]
  tratamentos  Tratamento[]
  recebimentos Recebimento[]
  retornos     Retorno[]
  receberCrs   ReceberCR[]
  documentos   Documento[]
  historicos   Historico[]
  enderecos    PacienteEndereco[]
  fones        PacienteFone[]
  emails       PacienteEmail[]
  beneficiosSub PacienteBeneficio[]

  @@map("paciente")
}

// ─── AGENDA ──────────────────────────────────────────────────────

model Agenda {
  id_agenda                           Int       @id @default(autoincrement())
  tx_descricao                        String    @db.VarChar(200)
  fl_ativo                            Boolean   @default(true)
  dt_inicio                           String?   @db.VarChar(5)
  dt_fim                              String?   @db.VarChar(5)
  cd_dia_semana                       String?   @db.VarChar(20)
  nr_intervalo                        Int       @default(30)
  dt_criacao                          DateTime  @default(now())
  dt_ini_grade                        DateTime?
  dt_fin_grade                        DateTime?
  vl_duracao_padrao                   Int?
  vl_zoom                             Int?
  id_formato_agendamento              Int?
  vl_def_opcao_novo_agendamento       Int?
  fl_alerta_agendamento               Boolean   @default(false)
  id_def_status                       Int?
  id_status_envio_confirm_enviado     Int?
  id_status_ret_confirm_sim           Int?
  id_status_ret_confirm_nao           Int?
  id_status_ret_confirm_nao_antecedencia Int?
  fl_omitir_domingo                   Boolean   @default(false)
  fl_omitir_sabado                    Boolean   @default(false)
  fl_omitir_nao_utilizados            Boolean   @default(false)
  fl_notificacao_email                Boolean   @default(false)
  tx_notificacao_email                String?   @db.VarChar(200)
  fl_agendamento_simultaneo           Boolean   @default(false)
  fl_elegibilidade_automatica         Boolean   @default(false)
  fl_informar_procedimento_agenda     Boolean   @default(false)
  id_cor                              Int?
  fl_autoagendamento                  Boolean   @default(false)
  fl_confirmacao_agendamento          Boolean   @default(false)
  id_meio_envio_confirmacao           Int?
  vl_antecedencia_confirmacao         Int?
  id_texto_envio_confirmacao          Int?
  fl_lembrete_agendamento             Boolean   @default(false)
  id_meio_envio_lembrete              Int?
  vl_antecedencia_lembrete            Int?
  id_texto_envio_lembrete             Int?
  fl_protocolo_agendamento            Boolean   @default(false)
  id_meio_envio_protocolo             Int?
  id_texto_envio_protocolo            Int?
  fl_lembrete_retorno                 Boolean   @default(false)
  id_meio_envio_retorno               Int?
  id_texto_envio_retorno              Int?

  id_prestador Int
  prestador    Prestador @relation(fields: [id_prestador], references: [id_prestador])

  id_conta Int
  conta    Conta @relation(fields: [id_conta], references: [id_conta])

  // --- campos adicionais RE-COMPLETA ---
  tx_agendamento_simultaneo String?  @db.VarChar(200)
  id_oauth_google           String?  @db.VarChar(200)
  id_oauth_boaconsulta      String?  @db.VarChar(200)
  tx_cor                    String?  @db.VarChar(20)
  vl_cor                    String?  @db.VarChar(20)
  fl_autoagendamento_odp    Boolean  @default(false)

  itens          AgendaItem[]
  bloqueios      AgendaBloqueio[]
  reservas       AgendaReserva[]

  @@map("agenda")
}

// ─── AGENDA ITEM ─────────────────────────────────────────────────

model AgendaItem {
  id_agenda_item            Int       @id @default(autoincrement())
  dt_inicio                 DateTime
  dt_fim                    DateTime
  tx_observacao             String?   @db.Text
  cd_status                 String    @default("AGENDADO") @db.VarChar(20)
  fl_ativo                  Boolean   @default(true)
  dt_criacao                DateTime  @default(now())
  id_unidade_atendimento    Int?
  vl_duracao                Int?
  vl_sala                   Int?
  id_status                 Int?
  id_tipo                   Int?
  tx_descricao              String?   @db.VarChar(200)
  tx_descricao2             String?   @db.VarChar(200)
  id_motivo_agendamento     String?   @db.VarChar(50)
  id_pt_item                Int?
  id_tipo_fone1             String?   @db.VarChar(20)
  tx_fone_ddd1              String?   @db.VarChar(4)
  tx_fone_nro1              String?   @db.VarChar(20)
  id_tipo_fone2             String?   @db.VarChar(20)
  tx_fone_ddd2              String?   @db.VarChar(4)
  tx_fone_nro2              String?   @db.VarChar(20)
  id_operadora              Int?
  id_pt_header              Int?
  fl_bloqueio               Boolean   @default(false)
  fl_ocultar                Boolean   @default(false)
  fl_copiar                 Boolean   @default(false)
  id_copia_tipo             Int?
  vl_copia_dia              Int?
  vl_copia_semana           Int?
  vl_copia_mes              Int?
  fl_elegibilidade          Boolean?
  fl_enviar_sms             Boolean?
  dt_time_stamp_checkin     DateTime?
  dt_time_stamp_atendimento DateTime?
  dt_time_stamp_checkout    DateTime?
  vl_rgb                    String?   @db.VarChar(20)
  id_turma                  Int?
  id_disciplina             Int?
  id_curso                  Int?

  id_agenda    Int
  agenda       Agenda    @relation(fields: [id_agenda], references: [id_agenda])
  id_paciente  Int
  paciente     Paciente  @relation(fields: [id_paciente], references: [id_paciente])
  id_prestador Int
  prestador    Prestador @relation(fields: [id_prestador], references: [id_prestador])
  id_conta     Int
  conta        Conta     @relation(fields: [id_conta], references: [id_conta])

  // --- campos adicionais RE-COMPLETA ---
  tx_elegibilidade          String?  @db.Text
  tx_elegibilidade_glosa    String?  @db.Text
  tx_google_event           String?  @db.VarChar(200)
  id_pt_planejamento_sessao Int?
  vl_copia_dia_1            Int?
  vl_copia_dia_2            Int?
  vl_copia_dia_3            Int?
  tx_enviar_sms             String?  @db.VarChar(200)
  tx_origem_agendamento     String?  @db.VarChar(100)

  @@map("agenda_item")
}

// ─── ESPECIALIDADE ───────────────────────────────────────────────

model Especialidade {
  id_especialidade Int      @id @default(autoincrement())
  tx_descricao     String   @db.VarChar(200)
  fl_ativo         Boolean  @default(true)
  dt_criacao       DateTime @default(now())

  id_conta Int
  conta    Conta @relation(fields: [id_conta], references: [id_conta])

  prestadores    Prestador[]
  procedimentos  ProcedimentoItem[]
  ptItens        PtItem[]
  regrasComissao RegraComissao[]

  @@map("especialidade")
}

// ─── CONVENIO ────────────────────────────────────────────────────

model Convenio {
  id_convenio  Int      @id @default(autoincrement())
  tx_descricao String   @db.VarChar(200)
  fl_ativo     Boolean  @default(true)
  dt_criacao   DateTime @default(now())

  id_conta Int
  conta    Conta @relation(fields: [id_conta], references: [id_conta])

  // --- campos adicionais RE-COMPLETA ---
  cd_convenio          String?  @db.VarChar(50)
  cd_ans_operadora     String?  @db.VarChar(50)
  id_operadora         Int?
  id_tab_prc           Int?
  id_tipo_convenio     Int?
  fl_regras_cobertura  Boolean  @default(false)
  fl_regras_repasse    Boolean  @default(false)
  tx_cnpj_operadora    String?  @db.VarChar(18)
  tx_nome_operadora    String?  @db.VarChar(200)
  tx_razao_operadora   String?  @db.VarChar(200)
  tx_regras_cobertura  String?  @db.Text
  tx_regras_repasse    String?  @db.Text
  tx_tabela_padrao     String?  @db.VarChar(200)

  credenciamentos Credenciamento[]

  @@map("convenio")
}

// ─── APP MODULO ──────────────────────────────────────────────────

model AppModulo {
  id_modulo    Int      @id @default(autoincrement())
  tx_descricao String   @db.VarChar(200)
  tx_alias     String?  @db.VarChar(100)
  nr_ordem     Int      @default(0)
  id_grupo     Int?
  tx_icone     String?  @db.VarChar(50)
  fl_ativo     Boolean  @default(true)

  id_conta Int?
  conta    Conta? @relation(fields: [id_conta], references: [id_conta])

  permissoes LoginPermissao[]

  @@map("app_modulo")
}

// ─── LOGIN PERMISSAO ─────────────────────────────────────────────

model LoginPermissao {
  id_login_permissao Int     @id @default(autoincrement())
  fl_consultar       Boolean @default(false)
  fl_inserir         Boolean @default(false)
